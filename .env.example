DEBUG=false
MAX_UPLOAD_SIZE_BYTES=5242880
OUTPUT_DIR=output

# AI PROVIDERS
# Provider API keys stay private in .env. Do not commit your real .env file.
#
# TEXT PROVIDER SWITCHES
# Set one provider to true to use only that provider for product/listing text.
# Set both to true to enable automatic fallback. TEXT_PROVIDER_PREFERENCE decides first choice.
OPENAI_TEXT_ENABLED=false
GEMINI_TEXT_ENABLED=true
TEXT_PROVIDER_PREFERENCE=auto
# Allowed values: auto, gemini, openai
# auto currently tries Gemini first, then OpenAI if Gemini fails.

# IMAGE PROVIDER SWITCHES
# Set one provider to true to use only that provider for image editing/generation.
# Set both to true to enable automatic fallback. IMAGE_PROVIDER_PREFERENCE decides first choice.
OPENAI_IMAGE_ENABLED=false
GEMINI_IMAGE_ENABLED=true
IMAGE_PROVIDER_PREFERENCE=auto
# Allowed values: auto, gemini, openai
# auto currently tries Gemini first, then OpenAI if Gemini fails.

# Legacy master switches. They are retained for older setups only.
# Use the capability switches above for new configurations.
OPENAI_ENABLED=true
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1

MONGODB_URI=your_mongodb_uri_here
# MONGODB_DB_NAME=product_ai_agent
# MONGODB_PRODUCTS_COLLECTION=products
# MONGODB_RUNS_COLLECTION=product_runs

AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_PREFIX=product-ai-agent

GEMINI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
